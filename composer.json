{
    "name": "laikait/laika-session",
    "description": "A php singleton session handler with file, redis, memcached, mysql and Laika Model drivers.",
    "keywords": [
        "php",
        "session",
        "singleton",
        "file",
        "redis",
        "memcached",
        "mysql",
        "pdo",
        "handler",
        "framework"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Laika\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laika\\Session\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "laikait/laika-model": "^4"
    },
    "suggest": {
        "ext-redis": "Required by the redis session driver (Config::redis()).",
        "ext-memcached": "Required by the memcached session driver (Config::memcached())."
    },
    "prefer-stable": true,
    "extra": {
        "laika": {
            "resources": {
                "models": {
                    "path": "src/Model",
                    "namespace": "Laika\\Session\\Model"
                },
                "schemas": {
                    "path": "src/Schema",
                    "namespace": "Laika\\Session\\Schema",
                    "contract": "Laika\\Model\\Contract\\SchemaAbstract"
                }
            }
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "compat": "phpcs --standard=phpcs.xml --report=full",
        "test": "phpunit"
    }
}
